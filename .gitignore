# Rå element-summary er ~700 filer og 7MB per snapshot. De committes ikke:
# de er fullt reproduserbare fra API-et, og ville sprengt repoet på en sesong.
data/raw/element_summary/
__pycache__/
*.pyc
.venv/

# Samarbeidsmappene: samme regel for rå element-summary.
samarbeid/*/data/element_summary/
.DS_Store

# Lokal kopi av vaastavs historiske sesonger for offline backtest.
data/cache/

# Store prediksjonsdumper fra målemotoren; gjenskapes av skriptene.
samarbeid/modell/**/*prediksjoner*.csv.gz
samarbeid/modell/**/p1p2_*.csv.gz
